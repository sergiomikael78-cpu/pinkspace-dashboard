{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pinkspace-dashboard",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pinkspace-db",
      "database_id": "731d4ac4-de57-48c9-b6ab-bb1bdb3c8c42"
    }
  ]
}
